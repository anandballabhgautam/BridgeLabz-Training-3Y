Q6. EMPLOYEE MANAGEMENT SYSTEM (Classes + Object Methods)
File: Q6.js
------------------------------------------------------------

class Employee {
    constructor(id, name, department, salary) {
        this.id = id;
        this.name = name;
        this.department = department;
        this.salary = salary; // Monthly salary
    }

    getAnnualSalary() {
        return this.salary * 12;
    }

    applyBonus(percent) {
        this.salary += this.salary * percent / 100;
    }
}

const employees = [
    new Employee(1, "Aman", "IT", 40000),
    new Employee(2, "Riya", "HR", 35000),
    new Employee(3, "Rahul", "Sales", 30000),
    new Employee(4, "Neha", "IT", 50000),
    new Employee(5, "Karan", "Finance", 45000)
];

// Example: Apply 10% bonus to the first employee.
employees[0].applyBonus(10);

employees.forEach(employee => {
    console.log(`${employee.name} (${employee.department}) - Annual Salary: Rs.${employee.getAnnualSalary()}`);
});

const totalAnnualPayout = employees.reduce((total, employee) => {
    return total + employee.getAnnualSalary();
}, 0);

console.log("Total annual payout: Rs." + totalAnnualPayout);


