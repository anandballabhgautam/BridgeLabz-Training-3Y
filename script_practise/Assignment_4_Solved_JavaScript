Q2. STUDENT FORM VALIDATOR (Forms + RegExp)
File: Q2.html
------------------------------------------------------------

<!DOCTYPE html>
<html>
<head>
    <title>Student Registration</title>
    <style>
        input { display: block; margin: 6px 0 2px; padding: 8px; }
        .valid { border: 2px solid green; }
        .invalid { border: 2px solid red; }
        .error { color: red; font-size: 13px; }
    </style>
</head>
<body>
    <h2>Student Registration</h2>
    <form id="studentForm">
        <label>Name <input id="name" type="text"></label><span id="nameError" class="error"></span>
        <label>Email <input id="email" type="text"></label><span id="emailError" class="error"></span>
        <label>Phone <input id="phone" type="text"></label><span id="phoneError" class="error"></span>
        <label>Password <input id="password" type="password"></label><span id="passwordError" class="error"></span>
        <button type="submit">Register</button>
    </form>
    <p id="message"></p>

    <script>
        const form = document.getElementById("studentForm");

        const rules = {
            name: /^[A-Za-z]+$/,
            email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
            phone: /^\d{10}$/,
            password: /^(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*(),.?":{}|<>]).+$/
        };

        const messages = {
            name: "Name must contain alphabets only.",
            email: "Enter a valid email address.",
            phone: "Phone must be exactly 10 digits.",
            password: "Password needs an uppercase letter, number, and special character."
        };

        function validateField(fieldName) {
            const input = document.getElementById(fieldName);
            const error = document.getElementById(fieldName + "Error");
            const valid = rules[fieldName].test(input.value.trim());

            input.classList.toggle("valid", valid);
            input.classList.toggle("invalid", !valid);
            error.textContent = valid ? "" : messages[fieldName];
            return valid;
        }

        Object.keys(rules).forEach(fieldName => {
            document.getElementById(fieldName).addEventListener("input", () => {
                validateField(fieldName);
            });
        });

        form.addEventListener("submit", event => {
            event.preventDefault();
            const isValid = Object.keys(rules).every(validateField);
            document.getElementById("message").textContent =
                isValid ? "Registration successful!" : "Please correct the errors.";
        });
    </script>
</body>
</html>


