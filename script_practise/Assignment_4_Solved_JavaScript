Q4. CUSTOM FORM BUILDER (Forms + Classes)
File: Q4.html
------------------------------------------------------------

<!DOCTYPE html>
<html>
<head>
    <title>Custom Form Builder</title>
</head>
<body>
    <h2>Dynamic Form</h2>
    <div id="formContainer"></div>
    <pre id="output"></pre>

    <script>
        class FormBuilder {
            constructor(fields, containerId) {
                this.fields = fields;
                this.container = document.getElementById(containerId);
                this.createForm();
            }

            createForm() {
                const fieldsHTML = this.fields.map(field => `
                    <label>
                        ${field.label}
                        <input type="${field.type}" name="${field.name}" required>
                    </label><br><br>
                `).join("");

                this.container.innerHTML = `
                    <form id="dynamicForm">
                        ${fieldsHTML}
                        <button type="submit">Submit</button>
                    </form>
                `;

                document.getElementById("dynamicForm").addEventListener("submit", event => {
                    event.preventDefault();
                    const data = this.getFormData();
                    document.getElementById("output").textContent =
                        JSON.stringify(data, null, 2);
                });
            }

            getFormData() {
                const formData = new FormData(document.getElementById("dynamicForm"));
                return Object.fromEntries(formData.entries());
            }
        }

        const fields = [
            { type: "text", label: "Username", name: "username" },
            { type: "email", label: "Email", name: "email" },
            { type: "password", label: "Password", name: "password" }
        ];

        new FormBuilder(fields, "formContainer");
    </script>
</body>
</html>


