Q9. SHOPPING CART TOTAL (Classes + RegExp for Coupon)
File: Q9.js
------------------------------------------------------------

class Cart {
    constructor() {
        this.items = [];
    }

    addItem(name, price, quantity) {
        this.items.push({ name, price, quantity });
    }

    getTotal() {
        return this.items.reduce((total, item) => {
            return total + item.price * item.quantity;
        }, 0);
    }

    applyCoupon(coupon) {
        // Accept coupon codes such as SAVE20 or DISC10.
        const couponPattern = /^(SAVE|DISC)(\d{1,2})$/;
        const match = coupon.trim().toUpperCase().match(couponPattern);

        if (!match) {
            console.log("Invalid coupon. Use a code like SAVE20 or DISC10.");
            return this.getTotal();
        }

        const discountPercent = Number(match[2]);

        if (discountPercent < 1 || discountPercent > 100) {
            console.log("Coupon discount must be between 1 and 100.");
            return this.getTotal();
        }

        const total = this.getTotal();
        const discountedTotal = total - (total * discountPercent / 100);

        console.log(`Coupon applied: ${discountPercent}% off`);
        return discountedTotal;
    }
}

const cart = new Cart();
cart.addItem("T-Shirt", 500, 2);
cart.addItem("Shoes", 2000, 1);
cart.addItem("Cap", 300, 3);

console.log("Cart total: Rs." + cart.getTotal().toFixed(2));

const finalTotal = cart.applyCoupon("SAVE20");
console.log("Final total: Rs." + finalTotal.toFixed(2));
