<!DOCTYPE html>
<html>
<head>
    <title>Movie Ticket Booking</title>
</head>
<body>
    <h2>Book Movie Tickets</h2>
    <form id="bookingForm">
        <label>Name: <input id="name" required></label><br><br>
        <label>Email: <input id="email" type="email" required></label><br><br>
        <label>Seats (1-10): <input id="seats" type="number" min="1" max="10" required></label><br><br>
        <button type="submit">Book Ticket</button>
    </form>
    <p id="message"></p>
    <pre id="ticket"></pre>

    <script>
        document.getElementById("bookingForm").addEventListener("submit", event => {
            event.preventDefault();

            const name = document.getElementById("name").value.trim();
            const email = document.getElementById("email").value.trim();
            const seats = Number(document.getElementById("seats").value);

            const namePattern = /^[A-Za-z ]+$/;
            const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

            if (!namePattern.test(name)) {
                document.getElementById("message").textContent = "Name must contain alphabets and spaces only.";
                return;
            }

            if (!emailPattern.test(email)) {
                document.getElementById("message").textContent = "Enter a valid email.";
                return;
            }

            if (!Number.isInteger(seats) || seats < 1 || seats > 10) {
                document.getElementById("message").textContent = "Seats must be a whole number from 1 to 10.";
                return;
            }

            const booking = { name, email, seats };
            document.getElementById("message").textContent = "Booking successful!";
            document.getElementById("ticket").textContent =
                `MOVIE TICKET\\nName: ${booking.name}\\nEmail: ${booking.email}\\nSeats: ${booking.seats}`;
        });
    </script>
</body>
</html>


